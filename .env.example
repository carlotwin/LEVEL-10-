# =============================================================================
# Level 10 SMS Outreach Campaign — configuration
# Copy this file to `.env` and adjust. Every value here is a SAFE DEFAULT.
#
# CORE PRINCIPLE: Fail closed. Changing ONE variable must never accidentally
# activate real texting. Live sending requires SANDBOX=false AND
# ALLOW_LIVE_SEND=true AND a real live adapter AND Cherry's approved templates
# with regenerated checksums — all four, independently.
# =============================================================================

# ---- Hard safety guards (see server/config/env.js) --------------------------

# Master environment switch. "true" = run against the SANDBOX adapter only.
# When true, the app can NEVER call a real REI BlackBook adapter.
SANDBOX=true

# Master send switch. Must be exactly "true" to perform the irreversible send.
# Ships "false". This is checked at the moment of send, in addition to SANDBOX.
ALLOW_LIVE_SEND=false

# Max sends per run (batch cap to protect the sending numbers). 0 = unlimited.
MAX_SENDS_PER_RUN=10

# Show the browser (live adapter only). "false" = background. Ignored in sandbox.
HEADLESS=false

# ---- Server -----------------------------------------------------------------
PORT=3000

# ---- Campaign ---------------------------------------------------------------
# Identifier for THIS campaign batch. The duplicate ledger is keyed on this +
# REI contact id + normalized phone, so the same contact is never re-texted for
# the same campaign after a restart, re-upload, or crash.
CAMPAIGN_BATCH=level-10-2026-07

# Tag that marks eligible contacts in REI BlackBook (SOP Step 2).
LEVEL10_TAG=Level 10 Properties

# Allowed states (comma separated). Contacts outside are skipped.
TEXT_STATES=CA,California

# ---- ProfitDial source of truth ---------------------------------------------
# The "With Contacts" tab of the Level 10 Master Spreadsheet is uploaded at
# runtime via the dashboard. These are the confirmed real header names; change
# only if the sheet's headers change.
PD_SHEET_TAB=With Contacts
PD_COL_PROFITDIAL=Profit Dial
PD_COL_ADDRESS=Full Address
PD_COL_PHONE=Primary Phone
PD_COL_NAME=Primary Name
# Contact ID column is absent in the current sheet; leave blank to disable.
PD_COL_CONTACT_ID=

# Optional: ingest the ProfitDial sheet straight from Google Sheets. Only works
# if the sheet is shared "Anyone with the link (Viewer)" or you pass a token via
# the dashboard. A private sheet returns a clear error (no columns invented).
PD_GOOGLE_SHEET_ID=1MbvHNCitKyDZ-7oLoUA9j0hV-qpzrEjYnw1twtKNJX4
PD_GOOGLE_SHEET_GID=1417278459

# ---- Live REI BlackBook adapter (Playwright) --------------------------------
# Read only when SANDBOX=false. The live adapter is fully built, but:
#   * It won't run until REIBB_LOGIN_URL (and creds) are set, and
#   * It cannot SEND until ALLOW_LIVE_SEND=true AND all placeholder templates
#     are removed AND config/reibb.selectors.json is verified for your account.
# Leaving these blank keeps live mode refused. Texting stays OFF by default.
REIBB_LOGIN_URL=https://my.reiblackbook.com/services/account/login
REIBB_EMAIL=
REIBB_PASSWORD=
ACTION_TIMEOUT_MS=15000
# Slow each Playwright action (ms) while verifying selectors. 0 = full speed.
SLOWMO_MS=500

# WATCH-ONLY verification: when SANDBOX=false, log in and walk each contact
# (filter, open, read, match ProfitDial) so you can WATCH the bot — but never
# opt-in and never send. Use this first to confirm the bot reads REI correctly.
WATCH_ONLY=true

# ---- MANDATORY SOP STEPS (no longer configurable) --------------------------
# REQUIRE_OPTIN, REQUIRE_PROFITDIAL and REQUIRE_LEVEL10_TAG were env flags. They
# are now hard-coded to true: a live SMS can never be sent without a verified
# opt-in, a verified ProfitDial sender (never REI's default number), and the
# "Level 10 Properties" tag present on the contact record. Setting any of them to
# false here has NO effect — the attempt is logged and ignored.

# Exact URL of the REI Contacts list (the page with the "Search By Name, Phone..."
# box). Optional but recommended: set it and the bot goes straight there instead
# of clicking a nav label or probing candidate paths. Copy it from your browser's
# address bar while looking at the Contacts list.
REIBB_CONTACTS_URL=


# =============================================================================
# Twin PPC decision system (ppc/) — the sync agent. See ppc/README.md and
# ppc/SETUP_CHECKLIST.md. Every value is read-only access; nothing here lets
# the system change Google Ads, REI BlackBook or GA4.
# =============================================================================

# Where the agent keeps its files (git-ignored) and where it writes the
# dashboard sync file. Point PPC_BUNDLE_DIR at a Google Drive for desktop
# folder, e.g. G:\My Drive\Twin PPC
PPC_DATA_DIR=data/ppc
PPC_BUNDLE_DIR=
PPC_TIMEZONE=America/Los_Angeles

# 32-byte key (64 hex characters) used ONLY to encrypt the saved REI sign-in.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PPC_SECRET_KEY=

# Optional: Google Chat or Slack incoming webhook for alerts.
PPC_ALERT_WEBHOOK_URL=

# ---- Google Ads API (read only) ---------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Get it with: npm run ppc:google-auth
GOOGLE_ADS_REFRESH_TOKEN=
# Ad account id (123-456-7890) and, if a manager account owns it, the manager id.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
PPC_ADS_BACKFILL_DAYS=90
PPC_ADS_LOOKBACK_DAYS=3

# ---- GA4 Data API (read only) -----------------------------------------------
GA4_PROPERTY_ID=
# Path to a service account JSON key kept OUTSIDE the repo (or leave blank to
# use the Google sign-in above, if it was allowed Analytics access).
GA4_SERVICE_ACCOUNT_FILE=
PPC_GA4_LOOKBACK_DAYS=90

# ---- REI BlackBook -----------------------------------------------------------
# Best: a folder where REI exports (CSV/XLSX) are saved. The newest file is imported.
PPC_REI_EXPORT_DIR=
# Or a Google Sheet shared "anyone with the link can view".
PPC_REI_SHEET_ID=
PPC_REI_SHEET_GID=
# Fallback: the crawler reads your own REI account. It uses REIBB_LOGIN_URL,
# REIBB_EMAIL and REIBB_PASSWORD from the section above, never bypasses MFA or
# CAPTCHA (run npm run ppc:rei-login to sign in yourself), and waits
# REI_CRAWL_DELAY_MS between pages.
REI_CRAWLER_ENABLED=false
REI_HEADLESS=true
REI_PERSIST_SESSION=false
REI_CRAWL_DELAY_MS=2500
REI_CRAWL_MAX_PAGES=20
REI_CRAWL_MAX_CONTACTS=150
REI_RECRAWL_HOURS=24
REI_CRAWL_TAG=
REI_FALLBACK_AFTER_FAILURES=3

# ---- Landing page scan -------------------------------------------------------
PPC_SITE_DOMAINS=twinhomebuyer.com
PPC_SITE_EXTRA_URLS=

# ---- Schedules (cron, in PPC_TIMEZONE) --------------------------------------
PPC_SCHEDULE_ADS=15 5 * * *
PPC_SCHEDULE_GA4=25 5 * * *
PPC_SCHEDULE_REI=5 */4 * * *
PPC_SCHEDULE_PAGES=40 4 * * 1
