# =============================================================================
# Level 10 SMS Outreach Campaign — configuration
# Copy this file to `.env` and adjust. Every value here is a SAFE DEFAULT.
#
# CORE PRINCIPLE: Fail closed. Changing ONE variable must never accidentally
# activate real texting. Live sending requires SANDBOX=false AND
# ALLOW_LIVE_SEND=true AND a real live adapter AND Cherry's approved templates
# with regenerated checksums — all four, independently.
# =============================================================================

# ---- Hard safety guards (see server/config/env.js) --------------------------

# Master environment switch. "true" = run against the SANDBOX adapter only.
# When true, the app can NEVER call a real REI BlackBook adapter.
SANDBOX=true

# Master send switch. Must be exactly "true" to perform the irreversible send.
# Ships "false". This is checked at the moment of send, in addition to SANDBOX.
ALLOW_LIVE_SEND=false

# Max sends per run (batch cap to protect the sending numbers). 0 = unlimited.
MAX_SENDS_PER_RUN=10

# Show the browser (live adapter only). "false" = background. Ignored in sandbox.
HEADLESS=false

# ---- Server -----------------------------------------------------------------
PORT=3000

# ---- Campaign ---------------------------------------------------------------
# Identifier for THIS campaign batch. The duplicate ledger is keyed on this +
# REI contact id + normalized phone, so the same contact is never re-texted for
# the same campaign after a restart, re-upload, or crash.
CAMPAIGN_BATCH=level-10-2026-07

# Tag that marks eligible contacts in REI BlackBook (SOP Step 2).
LEVEL10_TAG=Level 10 Properties

# Allowed states (comma separated). Contacts outside are skipped.
TEXT_STATES=CA,California

# ---- ProfitDial source of truth ---------------------------------------------
# The "With Contacts" tab of the Level 10 Master Spreadsheet is uploaded at
# runtime via the dashboard. These are the confirmed real header names; change
# only if the sheet's headers change.
PD_SHEET_TAB=With Contacts
PD_COL_PROFITDIAL=Profit Dial
PD_COL_ADDRESS=Full Address
PD_COL_PHONE=Primary Phone
PD_COL_NAME=Primary Name
# Contact ID column is absent in the current sheet; leave blank to disable.
PD_COL_CONTACT_ID=

# Optional: ingest the ProfitDial sheet straight from Google Sheets. Only works
# if the sheet is shared "Anyone with the link (Viewer)" or you pass a token via
# the dashboard. A private sheet returns a clear error (no columns invented).
PD_GOOGLE_SHEET_ID=1MbvHNCitKyDZ-7oLoUA9j0hV-qpzrEjYnw1twtKNJX4
PD_GOOGLE_SHEET_GID=1417278459

# ---- Live REI BlackBook adapter (Playwright) --------------------------------
# Read only when SANDBOX=false. The live adapter is fully built, but:
#   * It won't run until REIBB_LOGIN_URL (and creds) are set, and
#   * It cannot SEND until ALLOW_LIVE_SEND=true AND all placeholder templates
#     are removed AND config/reibb.selectors.json is verified for your account.
# Leaving these blank keeps live mode refused. Texting stays OFF by default.
REIBB_LOGIN_URL=
REIBB_EMAIL=
REIBB_PASSWORD=
ACTION_TIMEOUT_MS=15000
# Slow each Playwright action (ms) while verifying selectors. 0 = full speed.
SLOWMO_MS=0
