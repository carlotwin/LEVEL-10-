{
  "_README": "REI BlackBook selectors. The 'contacts' section is mapped from real screenshots of the account (Contacts list + Tags filter + search). The 'sms'/'chat' sections are still BEST-GUESS placeholders — they need a screenshot of the open SMS conversation (click the chat bubble on a row) showing the Opt-In control, the ProfitDial 'from number' selector, the message box, and Send. The live adapter fails closed if any required element is not found, so wrong selectors never cause a mis-send. Verify with HEADLESS=false + SLOWMO_MS before any live use.",

  "login": {
    "emailInput": "input[type=email], input[name=email]",
    "passwordInput": "input[type=password], input[name=password]",
    "submitButton": "button[type=submit], button:has-text('Sign In'), button:has-text('Log In')",
    "loggedInMarker": "text=Property Address"
  },

  "contacts": {
    "navContacts": "text=Contacts",
    "tagFilterOpen": "button:has-text('Tags'), text=Tags",
    "tagSearchInput": "input[placeholder='Search...']",
    "tagFilterOption": "text=%TAG%",
    "tagApply": "button:has-text('Apply')",
    "searchInput": "input[placeholder*='Search By Name' i], input[placeholder*='Search' i]",
    "resultRow": "tr, [role=row]",
    "resultRowByText": "text=%QUERY%",
    "rowChatIcon": "[aria-label*='SMS' i], [aria-label*='message' i], [title*='SMS' i], [title*='text' i]",
    "openContact": "text=%QUERY%"
  },

  "contact": {
    "nameField": "h1, h2, [data-testid=contact-name]",
    "addressField": "text=/Property Address/",
    "stateField": "[data-testid=contact-state]",
    "phoneRows": "[data-testid=contact-phone]",
    "tagChips": "text=Level 10 Properties",
    "notesField": "[data-testid=contact-notes]",
    "chatMessages": "[data-testid=chat-message]"
  },

  "sms": {
    "smsEnabledMarker": "text=/Opted[\\s-]?In/i, [data-testid=sms-enabled]",
    "optInButton": "button:has-text('Opt In'), text=Opt In",
    "optInConfirm": "button:has-text('Confirm'), button:has-text('Yes')",
    "optInSuccessMarker": "text=/Opted[\\s-]?In/i"
  },

  "chat": {
    "openChat": "[aria-label*='SMS' i], [title*='SMS' i]",
    "profitDialSelect": "[data-testid=profitdial-select], select[name*='from' i]",
    "profitDialOptions": "[data-testid=profitdial-option], option",
    "profitDialSelectedValue": "[data-testid=profitdial-selected]",
    "messageInput": "textarea, [contenteditable=true], [data-testid=message-input]",
    "sendButton": "button:has-text('Send')",
    "lastOutboundMessage": "[data-testid=message-outbound]:last-of-type",
    "deliveryStatus": "[data-testid=delivery-status]:last-of-type",
    "lastInboundMessage": "[data-testid=message-inbound]:last-of-type"
  }
}
